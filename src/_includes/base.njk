{%- set s = cms.site -%}
{%- set d = cms[key] -%}
{%- set home = (key == "home") -%}
{%- set fullTitle = d.seo_title if home else (d.seo_title + " | " + s.name) -%}
{%- set canonUrl = page.url | canon(s.site_url) -%}
{%- set ogImg = (d.hero_image | imgfb) | absurl(s.site_url) -%}
{%- set hrs = s | openhours -%}
{%- set cls = s | closeddays -%}
<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8"><meta name="format-detection" content="telephone=no"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ fullTitle }}</title><meta name="description" content="{{ d.seo_description }}">{% if d.noindex %}<meta name="robots" content="noindex">{% endif %}{% if canonUrl and not d.noindex %}<link rel="canonical" href="{{ canonUrl }}"><meta property="og:url" content="{{ canonUrl }}">{% endif %}<link rel="icon" href="{{ s.logo | imgfb }}" type="image/png"><link rel="icon" href="{{ s.logo | pub }}" type="image/avif"><meta property="og:type" content="website"><meta property="og:locale" content="ja_JP"><meta property="og:site_name" content="{{ s.name }}"><meta property="og:title" content="{{ fullTitle }}"><meta property="og:description" content="{{ d.seo_description }}">{% if ogImg %}<meta property="og:image" content="{{ ogImg }}">{% endif %}<meta name="twitter:card" content="{{ 'summary_large_image' if ogImg else 'summary' }}"><meta name="twitter:title" content="{{ fullTitle }}"><meta name="twitter:description" content="{{ d.seo_description }}">{% if ogImg %}<meta name="twitter:image" content="{{ ogImg }}">{% endif %}<meta name="theme-color" content="#1F2A17"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">{% if home %}{% preloadimg d.hero_image, "100vw" %}{% else %}{% preloadimg d.hero_image, "(max-width:900px) 100vw, 1200px" %}{% endif %}<link rel="stylesheet" href="/style.css">{% jsflag %}
<script type="application/ld+json">{{ s | ld(d, home, canonUrl, ogImg) | safe }}</script>
</head><body><a class="skip" href="#main">本文へスキップ</a><header class="hd" id="hd"><div class="in">
<a href="/" class="brand">{% img s.logo, s.logo_alt, "brand-mark", true, "50px" %}<span><span class="brand-name">{{ s.name }}</span><span class="brand-sub">{{ s.tagline }}</span></span></a>
<button class="burger" id="burger" aria-label="メニューを開く" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
<nav class="nav" id="nav" aria-label="メインメニュー"><a href="/"{% if home %} class="cur" aria-current="page"{% endif %}>ホーム</a><a href="/shinchiku"{% if key == "shinchiku" %} class="cur" aria-current="page"{% endif %}>新築</a><a href="/reform"{% if key == "reform" %} class="cur" aria-current="page"{% endif %}>リフォーム</a><a href="/services"{% if key == "services" %} class="cur" aria-current="page"{% endif %}>解体・白蟻・外構</a><a href="/company"{% if key == "company" %} class="cur" aria-current="page"{% endif %}>会社概要</a><a href="/staff"{% if key == "staff" %} class="cur" aria-current="page"{% endif %}>スタッフ</a><a href="{{ s.inos_url }}" target="_blank" rel="noopener" class="nav-sub">イノスの家<span class="ext">↗</span><span class="vh">（新しいタブで開きます）</span></a><a href="{{ s.instagram }}" target="_blank" rel="noopener" class="nav-sub">Instagram<span class="ext">↗</span><span class="vh">（新しいタブで開きます）</span></a><a href="{% if not home %}/{% endif %}#contact" class="nav-cta">お問い合わせ</a><a href="tel:{{ s.tel1 | replace('-', '') }}" class="nav-tel">電話で相談　{{ s.tel1 }}</a></nav></div></header>
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
<footer class="ft"><div class="wrap"><div class="ft-top"><div><a href="/" class="brand">{% img s.logo, "", "brand-mark", false, "50px" %}<span class="brand-name">{{ s.name }}</span></a><p class="sm">{{ s.address }}<br>TEL <a href="tel:{{ s.tel1 | replace('-', '') }}">{{ s.tel1 }}</a>{% if hrs %}<br>営業時間 {{ hrs }}{% endif %}{% if cls %}<br>定休日 {{ cls }}{% endif %}<br>{{ s.slogan }}</p></div>
<ul><li><a href="/">ホーム</a></li><li><a href="/shinchiku">新築</a></li><li><a href="/reform">リフォーム</a></li><li><a href="/services">解体・白蟻・外構</a></li><li><a href="/company">会社概要</a></li><li><a href="/staff">スタッフ紹介</a></li><li><a href="{{ s.inos_url }}" target="_blank" rel="noopener">イノスの家 ↗<span class="vh">（新しいタブで開きます）</span></a></li><li><a href="{{ s.instagram }}" target="_blank" rel="noopener">Instagram ↗<span class="vh">（新しいタブで開きます）</span></a></li><li><a href="/privacy">プライバシーポリシー</a></li></ul></div>
<p class="copy">&copy; {{ s.name }} All Rights Reserved.</p></div></footer><div class="mbar" id="mbar"><a class="m-tel" href="tel:{{ s.tel1 | replace('-', '') }}">電話で相談</a><a class="m-mail" href="{% if not home %}/{% endif %}{% if topic %}?topic={{ topic | topickey | urlenc }}{% endif %}#contact">無料お問い合わせ</a></div><script src="/main.js"></script></body></html>
