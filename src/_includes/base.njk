{%- set s = cms.site -%}
{%- set d = cms[key] -%}
{%- set home = (key == "home") -%}
{%- set fullTitle = d.seo_title if home else (d.seo_title + " | " + s.name) -%}
<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8"><meta name="format-detection" content="telephone=no"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ fullTitle }}</title><meta name="description" content="{{ d.seo_description }}"><link rel="icon" href="{{ s.logo | pub }}" type="image/avif"><meta property="og:type" content="website"><meta property="og:locale" content="ja_JP"><meta property="og:site_name" content="{{ s.name }}"><meta property="og:title" content="{{ fullTitle }}"><meta property="og:description" content="{{ d.seo_description }}"><meta name="twitter:card" content="summary"><meta name="theme-color" content="#1F2A17"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet"><link rel="preload" as="image" href="{{ d.hero_image | pub }}" fetchpriority="high"><link rel="stylesheet" href="/style.css"><script>document.documentElement.classList.add("js")</script>
<script type="application/ld+json">{{ s | ld(d, home) | safe }}</script>
</head><body><a class="skip" href="#main">本文へスキップ</a><header class="hd" id="hd"><div class="in">
<a href="index.html" class="brand">{% img s.logo, s.logo_alt, "brand-mark", true %}<span><span class="brand-name">{{ s.name }}</span><span class="brand-sub">{{ s.tagline }}</span></span></a>
<button class="burger" id="burger" aria-label="メニューを開く" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
<nav class="nav" id="nav" aria-label="メインメニュー"><a href="index.html"{% if home %} class="cur" aria-current="page"{% endif %}>ホーム</a><a href="shinchiku.html"{% if key == "shinchiku" %} class="cur" aria-current="page"{% endif %}>新築</a><a href="reform.html"{% if key == "reform" %} class="cur" aria-current="page"{% endif %}>リフォーム</a><a href="services.html"{% if key == "services" %} class="cur" aria-current="page"{% endif %}>その他サービス</a><a href="company.html"{% if key == "company" %} class="cur" aria-current="page"{% endif %}>会社概要</a><a href="staff.html"{% if key == "staff" %} class="cur" aria-current="page"{% endif %}>スタッフ</a><a href="{{ s.inos_url }}" target="_blank" rel="noopener">イノスの家<span class="ext">↗</span><span class="vh">（新しいタブで開きます）</span></a><a href="{{ s.instagram }}" target="_blank" rel="noopener">Instagram<span class="ext">↗</span><span class="vh">（新しいタブで開きます）</span></a><a href="{% if not home %}index.html{% endif %}#contact" class="nav-cta">お問い合わせ</a><a href="tel:{{ s.tel1 | replace('-', '') }}" class="nav-tel">電話で相談　{{ s.tel1 }}</a></nav></div></header>
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
<footer class="ft"><div class="wrap"><div class="ft-top"><div><a href="index.html" class="brand">{% img s.logo, "", "brand-mark", true %}<span class="brand-name">{{ s.name }}</span></a><p class="sm">{{ s.address }}<br>TEL <a href="tel:{{ s.tel1 | replace('-', '') }}">{{ s.tel1 }}</a><br>{{ s.slogan }}</p></div>
<ul><li><a href="index.html">ホーム</a></li><li><a href="shinchiku.html">新築</a></li><li><a href="reform.html">リフォーム</a></li><li><a href="services.html">その他サービス</a></li><li><a href="company.html">会社概要</a></li><li><a href="staff.html">スタッフ紹介</a></li><li><a href="{{ s.inos_url }}" target="_blank" rel="noopener">イノスの家 ↗<span class="vh">（新しいタブで開きます）</span></a></li><li><a href="{{ s.instagram }}" target="_blank" rel="noopener">Instagram ↗<span class="vh">（新しいタブで開きます）</span></a></li></ul></div>
<p class="copy">&copy; {{ s.name }} All Rights Reserved.</p></div></footer><div class="mbar" id="mbar"><a class="m-tel" href="tel:{{ s.tel1 | replace('-', '') }}">電話で相談</a><a class="m-mail" href="{% if not home %}index.html{% endif %}{% if topic %}?topic={{ topic | urlenc }}{% endif %}#contact">無料お問い合わせ</a></div><script src="/main.js"></script></body></html>
