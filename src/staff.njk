---
layout: base.njk
key: staff
permalink: staff.html
---
{%- set d = cms.staff -%}{%- set s = cms.site -%}{%- set cta_topic = "" -%}{%- set cta_btn = "お問い合わせはこちら" -%}
{% include "phero.njk" %}<section class="sec"><div class="wrap"><div class="rv"><div class="label">{{ d.list_label }}</div><h2 class="title">{{ d.list_title }}</h2><p class="lead">{{ d.list_lead }}</p></div><div class="staff">{% for m in d.members %}<article class="sc rv"><div class="sc-ph">{% img m.image, m.alt %}<span class="role">{{ m.role }}</span></div><div class="sc-b"><span class="kana">{{ m.kana }}</span><div class="nm">{{ m.name }}</div><div class="qt">{{ m.quote }}</div><div class="ql">{{ m.list_title }}</div><ul>{% for i in m.items %}<li>{{ i }}</li>{% endfor %}</ul>{% if m.note %}<p class="note">{{ m.note }}</p>{% endif %}</div></article>{% endfor %}</div>{% include "cta.njk" %}</div></section>
