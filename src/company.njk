---
layout: base.njk
key: company
permalink: company.html
---
{%- set d = cms.company -%}{%- set s = cms.site -%}{%- set cta_topic = "" -%}{%- set cta_btn = "お問い合わせはこちら" -%}
{% include "phero.njk" %}<section class="sec"><div class="wrap"><div class="rv"><div class="label">{{ d.table_label }}</div><h2 class="title">{{ d.table_title }}</h2></div><dl class="dl rv"><div><dt>屋号</dt><dd>{{ s.name }}</dd></div><div><dt>所在地</dt><dd>〒{{ s.zip }}　{{ s.address }}</dd></div><div><dt>連絡先（{{ s.tel1_label }}）</dt><dd>TEL <a href="tel:{{ s.tel1 | replace('-', '') }}">{{ s.tel1 }}</a>　／　FAX {{ s.fax1 }}</dd></div><div><dt>連絡先（{{ s.tel2_label }}）</dt><dd>TEL <a href="tel:{{ s.tel2 | replace('-', '') }}">{{ s.tel2 }}</a>　／　FAX {{ s.fax2 }}</dd></div>{% if s | openhours %}<div><dt>営業時間</dt><dd>{{ s | openhours }}</dd></div>{% endif %}{% if s | closeddays %}<div><dt>定休日</dt><dd>{{ s | closeddays }}</dd></div>{% endif %}<div><dt>創業</dt><dd>{{ d.founded }}</dd></div><div><dt>事業内容</dt><dd>{{ d.business }}</dd></div>{% for r in d.extra_rows %}<div><dt>{{ r.term }}</dt><dd>{{ r.desc }}</dd></div>{% endfor %}</dl>
<div class="tl rv">{% for t in d.timeline %}<div><b>{{ t.when }}</b><span>{{ t.text }}</span></div>{% endfor %}</div>
<div class="rv" style="margin-top:100px"><div class="label">{{ d.access_label }}</div><h2 class="title">{{ d.access_title }}</h2><p class="lead">〒{{ s.zip }}　{{ s.address }}</p></div><div class="map big rv"><iframe src="https://www.google.com/maps?q={{ ((s.legal_name or s.name) + " " + s.address) | urlenc }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ s.name }} 地図"></iframe></div>{% include "cta.njk" %}</div></section>
