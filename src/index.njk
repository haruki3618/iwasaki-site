---
layout: base.njk
key: home
permalink: index.html
---
{%- set d = cms.home | merge(cms.home_about, cms.home_services, cms.home_works, cms.home_contact) -%}{%- set s = cms.site -%}
<section class="hero"><div class="hero-bg">{% img d.hero_image, "", "", "high", "100vw" %}</div><div class="wrap">
<div class="hero-tag"><i></i>{{ d.hero_tag }}</div>
<h1>{{ d.hero_title_a }}<em>{{ d.hero_title_em }}</em>{{ d.hero_title_b }}</h1>
<p class="sub">{{ d.hero_sub }}</p>
<div class="hero-actions"><a href="#contact" class="btn btn-lime">無料相談・お見積り<span class="arr">→</span></a><a href="tel:{{ s.tel1 | replace('-', '') }}" class="btn btn-ghost hero-tel"><span class="hero-tel-l">電話する</span><span class="hero-tel-n">{{ s.tel1 }}</span></a></div>
<a href="#about" class="hero-link">会社について見る<span aria-hidden="true"> ↓</span></a></div>
<div class="hero-corp">IWASAKI × HOUSING HIMI</div><div class="scroll"></div></section>

<div class="ribbon"><div class="wrap">{% for r in d.ribbon %}<div class="rb"><b>{{ r.num }}</b><span>{{ r.label }}</span></div>{% endfor %}</div></div>

<section class="sec" id="about"><div class="wrap about-grid">
<div class="rv"><div class="label">{{ d.about_label }}</div><h2 class="title">{{ d.about_title | br | safe }}</h2>
<p>{{ d.about_text }}</p>
<a href="/company" class="tlink">{{ d.about_link }}</a></div>
<div class="about-img rv d1">{% img d.about_image, d.about_alt, "", false, "(max-width:900px) 100vw, 540px" %}<div class="chip"><small>{{ d.about_chip_small }}</small>{{ d.about_chip }}</div></div></div></section>

<section class="sec" style="padding-top:0"><div class="wrap">
<div class="svc-head rv"><div><div class="label">{{ d.services_label }}</div><h2 class="title" style="margin:0">{{ d.services_title }}</h2></div><p class="lead">{{ d.services_lead }}</p></div>
<div class="bento">
{%- set hrefs = ["/shinchiku", "/reform", "/services#kaitai", "/services#shiroari"] -%}
{%- set extra = ["", " d1", "", " d1"] -%}
{% for c in d.cards %}<a href="{{ (c.link | internal) or hrefs[loop.index0] }}" class="bc b{{ loop.index }}{% if c.variant == "white" or (not c.variant and loop.index == 4) %} white-bg{% endif %} rv{{ extra[loop.index0] }}">{% img c.image, c.alt, "", false, "(max-width:900px) 100vw, 700px" %}<div class="tx"><span class="no">0{{ loop.index }}</span><h3>{{ c.title }}</h3><p>{{ c.text }}</p><span class="go">{{ c.go }}</span></div><span class="arw" aria-hidden="true">→</span></a>
{% endfor %}</div>
<div class="inos rv" id="inos">{% img d.inos_image, d.inos_alt, "", false, "(max-width:900px) 100vw, 590px" %}<div class="tx"><div class="label">{{ d.inos_label }}</div><h3>{{ d.inos_title }}</h3><p>{{ d.inos_text }}</p><a href="{{ s.inos_url }}" target="_blank" rel="noopener" class="btn btn-lime">{{ d.inos_button }}<span class="vh">（新しいタブで開きます）</span></a></div></div>
</div></section>

{% if d.works and d.works.length %}<section class="sec alt" id="works"><div class="wrap">
<div class="svc-head rv"><div><div class="label">{{ d.works_label }}</div><h2 class="title" style="margin:0">{{ d.works_title }}</h2></div><p class="lead">{{ d.works_lead }}</p></div>
<div class="works">{% for w in d.works %}<figure class="wk rv{% if loop.index0 % 3 == 1 %} d1{% elif loop.index0 % 3 == 2 %} d2{% endif %}">{% img w.image, w.alt, "", false, "(max-width:520px) 100vw, (max-width:900px) 50vw, 380px" %}<figcaption><b>{{ w.title }}</b><span>{{ w.text }}</span></figcaption></figure>
{% endfor %}</div>
<p class="works-more rv"><a href="/shinchiku" class="tlink">新築の事例をもっと見る →</a>　<a href="/reform" class="tlink">リフォームについて →</a></p></div></section>{% endif %}

{% if d.flow and d.flow.length %}<section class="sec flow-sec" id="flow"><div class="wrap">
<div class="svc-head rv"><div><div class="label">{{ d.flow_label }}</div><h2 class="title" style="margin:0">{{ d.flow_title }}</h2></div><p class="lead">{{ d.flow_lead }}</p></div>
<div class="steps flow">{% for f in d.flow %}<div class="step rv{% if loop.index0 == 1 %} d1{% elif loop.index0 == 2 %} d2{% endif %}"><h3>{{ f.title }}</h3><p>{{ f.text }}</p></div>{% endfor %}</div></div></section>{% endif %}

{% if d.voices and d.voices.length %}<section class="sec alt" id="voices"><div class="wrap">
<div class="rv"><div class="label">{{ d.voices_label }}</div><h2 class="title">{{ d.voices_title }}</h2></div>
<div class="voices">{% for v in d.voices %}<blockquote class="vc rv"><p>{{ v.text }}</p><footer>{{ v.name }}{% if v.kind %}<span>{{ v.kind }}</span>{% endif %}</footer></blockquote>{% endfor %}</div></div></section>{% endif %}

<section class="sec contact on-dark" id="contact"><div class="wrap">
<div class="rv"><div class="label">{{ d.contact_label }}</div><h2 class="title">{{ d.contact_title }}</h2><p class="lead">{{ d.contact_lead }}</p></div>
<div class="contact-grid"><div class="rv"><div class="addr">〒{{ s.zip }}<br>{{ s.address }}</div>
{%- set hrs = s | openhours -%}{%- set cls = s | closeddays -%}
{% if hrs or cls %}<dl class="hrs">{% if hrs %}<div><dt>営業時間</dt><dd>{{ hrs }}</dd></div>{% endif %}{% if cls %}<div><dt>定休日</dt><dd>{{ cls }}</dd></div>{% endif %}</dl>{% endif %}
<div class="tel-card"><h3>{{ s.tel1_label }}</h3><div><div class="num"><a href="tel:{{ s.tel1 | replace('-', '') }}">TEL {{ s.tel1 }}</a></div><small>FAX {{ s.fax1 }}</small></div></div>
<div class="tel-card"><h3>{{ s.tel2_label }}</h3><div><div class="num"><a href="tel:{{ s.tel2 | replace('-', '') }}">TEL {{ s.tel2 }}</a></div><small>FAX {{ s.fax2 }}</small></div></div>
<div class="map"><iframe src="https://www.google.com/maps?q={{ ((s.legal_name or s.name) + " " + s.address) | urlenc }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ s.name }} 地図"></iframe></div></div>
<div class="form rv d1"><form id="cform" action="{{ s.form_action }}" method="post">
<div class="hp" aria-hidden="true"><label for="hp_note">この欄は空のままにしてください</label><input type="text" id="hp_note" name="hp_note" tabindex="-1" autocomplete="off" value=""></div>
<div class="fg"><label for="name">お名前<span class="req">必須</span></label><input type="text" id="name" name="お名前" class="fc" required maxlength="100" placeholder="山田 太郎" autocomplete="name"></div>
<div class="frow"><div class="fg"><label for="phone">電話番号</label><input type="tel" id="phone" name="電話番号" class="fc" maxlength="30" autocomplete="tel" inputmode="tel" placeholder="090-0000-0000"></div>
<div class="fg"><label for="email">メールアドレス</label><input type="email" id="email" name="メールアドレス" class="fc" maxlength="254" placeholder="example@domain.com" autocomplete="email" inputmode="email"></div></div>
<p class="fhint"><span class="req">必須</span>電話番号・メールアドレスは、どちらか一方で大丈夫です。</p>
<div class="fg"><label for="topic">ご相談内容</label><select id="topic" name="ご相談内容" class="fc"><option value="">選択してください</option>{% for t in topics %}<option value="{{ t.label }}" data-key="{{ t.key }}">{{ t.label }}</option>{% endfor %}</select></div>
<details class="more"><summary>住所・メッセージも書く（任意）</summary>
<div class="fg"><label for="address">住所</label><input type="text" id="address" name="住所" class="fc" maxlength="200" autocomplete="street-address" placeholder="富山県氷見市..."></div>
<div class="fg"><label for="message">メッセージ</label><textarea id="message" name="メッセージ" class="fc" maxlength="3000" placeholder="例：築30年の実家の水まわりをリフォームしたい／空き家の解体を考えている など"></textarea></div></details>
<p class="fnote">お急ぎの方はお電話（<a href="tel:{{ s.tel1 | replace('-', '') }}">{{ s.tel1 }}</a>{% if hrs %}／営業時間 {{ hrs }}{% endif %}）でもご相談いただけます。いただいた個人情報はご返信の目的にのみ使用します（<a href="/privacy">プライバシーポリシー</a>）。</p><button type="submit" class="btn btn-lime">この内容で相談する<span class="arr">→</span></button></form></div></div></div></section>
