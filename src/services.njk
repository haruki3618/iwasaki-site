{%- set d = cms.services -%}{%- set s = cms.site -%}{%- set cta_topic = "" -%}{%- set cta_btn = "無料相談・お見積りはこちら" -%}
{% include "phero.njk" %}<section class="sec"><div class="wrap">{% for b in d.blocks %}<div class="dr{% if loop.index0 % 2 == 1 %} rev{% endif %}"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="dr-img rv">{% img b.image, b.alt, ("contain" if b.contain else "") %}</div><div class="rv d1"><div class="label">{{ b.label }}</div><h2>{{ b.title }}</h2>{% for p in b.paragraphs %}<p>{{ p }}</p>{% endfor %}{% if b.checks.length %}<ul class="checks">{% for c in b.checks %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}{% if b.link %}<div class="dr-act"><a class="tlink" href="index.html{% if b.topic %}?topic={{ b.topic | urlenc }}{% endif %}#contact">{{ b.link }}</a></div>{% endif %}</div></div>{% endfor %}{% include "cta.njk" %}</div></section>
